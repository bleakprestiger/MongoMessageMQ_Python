MONGO_URI=mongodb+srv://mquser:kpWhs7tmXcx3Q5it@mongomessagemq.x4ocogw.mongodb.net/?retryWrites=true&w=majority&appName=MongoMessageMQ
MONGO_DB_NAME=MongoMessageMQ

# TLS/SSL Configuration (optional) (Need to Keep the MONGO_TLS & MONGO_ALLOW_INVALID_CERTS values to be set as true and false respectively)
MONGO_TLS=true
# MONGO_CA_FILE=/path/to/ca.pem
# MONGO_CERT_KEY_FILE=/path/to/client.pem
MONGO_ALLOW_INVALID_CERTS=false

# Queue Settings
MQ_MAX_RETRIES=3
MQ_RETRY_DELAY=1.0
MQ_VISIBILITY_TIMEOUT=300      # 5 minutes
MQ_HEARTBEAT_INTERVAL=30       # 30 seconds
MQ_MAX_ATTEMPTS=3              # Max delivery attempts before failing
MQ_RETENTION_DAYS=7            # Auto-delete completed messages after 7 days